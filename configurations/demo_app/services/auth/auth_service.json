{
    "type": "SERVICE",
    "$id" : "SERVICES/AUTH_SERVICE",
    "path" : "/services/auth/auth_service",
    "variables": [
        {
            "declarationType": "CONST",
            "name": "contextVar",
            "varType": "OBJECT",
            "$id": "VARIABLES/VAR1_UUID",
            "PROPERTIES": {
                "isAll": {
                    "type": "LITERAL",
                    "value": " new createContext()"
                }
            }
        }
    ],
    "imports": {
        "reducer": [
            "reducer1_uuid"
        ],
        "other": [
            {
                "TYPE": "THIRD_PARTY",
                "from": "@reduxjs/toolkit",
                "import_entity": "{configureStore}",
                "import_type": "FULL"
            }
        ]
    }
}