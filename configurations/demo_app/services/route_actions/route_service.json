{
    "type": "SERVICE",
    "$id" : "SERVICES/ROUTE_SERVICE",
    "path" : "/services/route_actions/route_service",
    "variables": [
        {
            "declarationType": "CONST",
            "name": "contextVar",
            "varType": "OBJECT",
            "$id": "VARIABLES/VAR1_UUID",
            "PROPERTIES": {
                "isAll": {
                    "type": "LITERAL",
                    "value": " new createContext()"
                }
            }
        },
        {
            "name": "authenticate",
            "declarationType": "CONST",
            "varType": "FUNCTION",
            "$id": "FUNCTIONS/UUID1",
            "isAnonymous": false,
            "parameters": {
                "list": [
                    {
                        "name": "Username"
                    },
                    {
                        "name": "Password"
                    }
                ]
            },
            "isAsync": true,
            "body": "return await new Promise((resolve, reject) => { \n const user = new CognitoUser({ Username, Pool });\n const authDetails = new AuthenticationDetails({ Username, Password });\n user.authenticateUser(authDetails, {\nonSuccess: (data) => {\nconsole.log('onSuccess', data);resolve(data);\n},\nonFailure: (err) => {\nconsole.error('onFailure', err);reject(err);\n} });});"
        }
    ],
    "imports": {
        "reducer": [
            "reducer1_uuid"
        ],
        "other": [
            {
                "TYPE": "THIRD_PARTY",
                "from": "@reduxjs/toolkit",
                "import_entity": "{configureStore}",
                "import_type": "FULL"
            },
            {
                "TYPE" : "SERVICE",
                "from" : "SERVICES/AUTH_SERVICE",
                "import_entity": "contextVar",
                "import_type" : "SINGLE"
            }
        ]
    }
}